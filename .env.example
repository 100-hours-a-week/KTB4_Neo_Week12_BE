JWT_SECRET=local-development-secret-change-before-production-32bytes
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# 운영 Spring Profile과 RDS MySQL 접속 정보
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/community?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&sslMode=REQUIRED
DB_USERNAME=community_app
DB_PASSWORD=change-this-rds-password
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# EC2에서는 Access Key 대신 인스턴스 IAM Role을 사용한다.
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=ktb-community-be
S3_PUBLIC_BASE_URL=https://your-cloudfront-domain.cloudfront.net
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300
S3_UPLOAD_SESSION_TTL_SECONDS=600
S3_MAX_IMAGE_SIZE=10485760

DOCKER_USERNAME=your-dockerhub-username
